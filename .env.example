# Compose interpolation only. Copy to .env; never commit the resulting file.
OPENAI_API_KEY=
CLIENT_ID=waaxalma-for-elimane
PUBLIC_BACKEND_URL=http://localhost:8000
BACKEND_PORT=8000
UI_PORT=8501
LOG_LEVEL=info
REQUEST_TIMEOUT_SECONDS=120
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# Optional provider/model/retry overrides used by Compose:
TRANSLATION_PROVIDER=openai
SPEECH_PROVIDER=openai
SPEECH_TO_TEXT_PROVIDER=openai
CONTEXT_PROVIDER=passthrough
QUALITY_PROVIDER=deterministic
REALTIME_TRANSLATION_PROVIDER=openai
STREAMING_TRANSCRIPTION_PROVIDER=openai
STREAMING_TRANSLATION_PROVIDER=openai
STREAMING_SPEECH_PROVIDER=openai
OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
SPEECH_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
REALTIME_TRANSLATION_MODEL=gpt-realtime-translate
REALTIME_TRANSLATION_VOICE=marin
STREAMING_TRANSCRIPTION_MODEL=gpt-live-transcribe
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_INITIAL_BACKOFF_SECONDS=0.5
PROVIDER_BACKOFF_MULTIPLIER=2.0
PROVIDER_MAX_BACKOFF_SECONDS=4.0
PROVIDER_JITTER_RATIO=0.2
STT_TIMEOUT_SECONDS=30
TRANSLATION_TIMEOUT_SECONDS=20
TTS_TIMEOUT_SECONDS=30

# Leave blank to inherit standard model/voice values.
STREAMING_TRANSLATION_MODEL=
STREAMING_SPEECH_MODEL=
STREAMING_SPEECH_VOICE=

# Slice 5 optional observability (no collector needed by default).
OTEL_ENABLED=false
OTEL_TRACES_SAMPLE_RATIO=1.0
OTEL_SERVICE_NAME=waaxalma
# Full OTLP/HTTP trace URL. Required only when OTEL_ENABLED=true.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Optional token prices in USD per million; no built-in pricing assumptions.
PROVIDER_TOKEN_PRICES_USD_PER_MILLION={}
INSTALL_OTEL=false

# Slice 6 closed-session retention; active sessions are never automatically deleted.
SESSION_RETENTION_DAYS=30
SESSION_CLEANUP_ENABLED=false
SESSION_CLEANUP_INTERVAL_SECONDS=3600
SHUTDOWN_TIMEOUT_SECONDS=15
TELEMETRY_SHUTDOWN_TIMEOUT_SECONDS=5
